{
  "name": "videodl-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Private Telegram bot for homelab YouTube downloads",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=src/index.ts --test-coverage-include-all --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && pnpm typecheck",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "26.6.6",
    "@types/node-fetch": "2.6.13",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "abort-controller": "3.0.0",
    "grammy": "1.46.0"
  }
}
