#!/usr/bin/env node
import { writeFileSync } from 'node:fs';
import { execFileSync } from 'node:child_process';
const args = process.argv.slice(2);
if (args.includes('--skip-download')) {
  console.log(JSON.stringify({id:'abcdefghijk',title:'Fixture',duration:1,live_status:'not_live',availability:'public'}));
} else {
  writeFileSync('/downloads/attempt', String(process.pid), {flag:'wx'});
  const output = args[args.indexOf('-o') + 1].replace('%(ext)s','mp3');
  writeFileSync(output, 'partial');
  console.log('progress: 25%');
  await new Promise(resolve => setTimeout(resolve, 500));
  if (process.env.SCENARIO === 'failure') process.exit(1);
  if (process.env.SCENARIO === 'cancel') await new Promise(() => setInterval(() => {}, 1000));
  execFileSync('ffmpeg',['-y','-f','lavfi','-i','sine=frequency=440:duration=1','-b:a','320k',output],{stdio:'ignore'});
}
