# Required. Never commit a real token. Only this user can use the bot in a DM.
TELEGRAM_BOT_API_KEY=
TELEGRAM_ALLOWED_USER_ID=

# Optional absolute output path; blank defaults to ./downloads.
# For containers, mount an existing host folder at /downloads.
DOWNLOAD_DIR=

# Optional positive resource limits. Final MP3 conversion/MP4 merge is checked too.
MAX_DURATION_SECONDS=7200
MAX_FILE_BYTES=4294967296
FREE_SPACE_RESERVE_BYTES=2147483648
JOB_DEADLINE_MS=3600000
