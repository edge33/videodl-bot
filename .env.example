# Required. Never commit a real token. Only this user can use the bot in a DM.
TELEGRAM_BOT_API_KEY=
TELEGRAM_ALLOWED_USER_ID=

# Optional absolute local paths; blank defaults to ./downloads and ./state.
# These become host bind-mount paths for Docker Compose in Stage 5.
# Downloaded media files are saved here.
DOWNLOAD_DIR=

# Persistent SQLite database (queue.sqlite): menus, jobs, and status/history.
# Preserve this directory across restarts so queued requests and outcomes survive.
STATE_DIR=

# Optional positive pending-job limit (one additional active slot).
QUEUE_MAX_PENDING=20
