# Required. Never commit a real token. Only this user can use the bot in a DM.
TELEGRAM_BOT_API_KEY=
TELEGRAM_ALLOWED_USER_ID=

# Optional absolute local paths; blank defaults to ./downloads and ./state.
# For Docker Compose, set existing absolute host bind-mount paths.
# Host directories must be writable by APP_UID/APP_GID; Compose will not create them.
# Downloaded media files are saved here.
DOWNLOAD_DIR=

# Persistent SQLite database (queue.sqlite): menus, jobs, and status/history.
# Preserve this directory across restarts so queued requests and outcomes survive.
STATE_DIR=

# Optional positive pending-job limit (one additional active slot).
QUEUE_MAX_PENDING=20

# Optional positive resource limits. Final MP3 conversion/MP4 merge is checked too.
MAX_DURATION_SECONDS=7200
MAX_FILE_BYTES=4294967296
FREE_SPACE_RESERVE_BYTES=2147483648
JOB_DEADLINE_MS=3600000

# Optional Docker image user/group IDs; rebuild the image after changing them.
# Match ownership of the host DOWNLOAD_DIR and STATE_DIR bind mounts.
APP_UID=1000
APP_GID=1000
